# Copier ce fichier en ".env" (cp .env.example .env) puis adapter.
# Le fichier .env ne doit JAMAIS être commité (il est dans .gitignore).

# ---- Base source (Postgres dans Docker) -- voir docker-compose.yml ---------
POSTGRES_USER=telecom
POSTGRES_PASSWORD=telecom
POSTGRES_DB=telecom_source
# Pour les scripts lancés depuis votre PC (le port 5433 évite un conflit avec un Postgres local)
SOURCE_DB_HOST=localhost
SOURCE_DB_PORT=5433

# ---- Kafka / Debezium -------------------------------------------------------
KAFKA_BOOTSTRAP=localhost:29092
CONNECT_URL=http://localhost:8083

# ---- Data lake S3 -----------------------------------------------------------
# MinIO (local) : console http://localhost:9001
# Pour Snowflake il faudra un vrai bucket AWS S3 : mettre alors S3_ENDPOINT_URL vide + vraies clés.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=telecom-datalake
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=eu-west-1

# ---- Snowflake (à remplir quand M1 a créé le compte) -----------------------
# SNOWFLAKE_ACCOUNT = identifiant de compte, ex. "xy12345.eu-west-1" (sans https://)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=WH_TELECOM
SNOWFLAKE_DATABASE=TELECOM_CHURN
